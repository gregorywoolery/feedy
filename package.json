    "storage:cleanup": "tsx scripts/storage-cleanup.ts",
    "format": "prettier --write src scripts tests docs *.md *.json *.mjs",
    "format:check": "prettier --check src scripts tests docs *.md *.json *.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "storage:reconcile": "tsx scripts/storage-reconcile.ts"
  },
  "dependencies": {
