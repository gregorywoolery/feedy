DATABASE_URL=postgresql://feedy:feedy@localhost:5433/feedy?sslmode=disable
DATABASE_SCHEMA=public
# Optional full-Docker override. Leave empty to use the Compose `db` service,
# or set a Supabase/PostgreSQL URL that is reachable from the app container.
DOCKER_DATABASE_URL=
POSTGRES_URL=
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
# Use STORAGE_DRIVER=database on serverless hosts such as Vercel.
# STORAGE_URL can hold the shared external asset base for future S3 delivery.
STORAGE_URL=

POSTGRES_DB=feedy
POSTGRES_USER=feedy
POSTGRES_PASSWORD=feedy
POSTGRES_PORT=5433
APP_PORT=3000
